{
  "openapi": "3.1.0",
  "info": {
    "title": "Molan Sync API",
    "version": "1.0.0",
    "description": "墨览账号、设备、文件对象和增量同步的唯一 HTTP 契约。传输对象允许忽略未知字段，核心文件对象继续引用同目录 JSON Schema。"
  },
  "servers": [{ "url": "http://127.0.0.1:43120", "description": "本地开发" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/v1/health": { "get": { "security": [], "operationId": "getHealth", "responses": { "200": { "$ref": "#/$defs/okResponse" }, "503": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/auth/code/request": { "post": { "security": [], "operationId": "requestLoginCode", "requestBody": { "$ref": "#/$defs/requestLoginCodeBody" }, "responses": { "202": { "$ref": "#/$defs/okResponse" }, "400": { "$ref": "#/$defs/errorResponseComponent" }, "429": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/auth/code/verify": { "post": { "security": [], "operationId": "verifyLoginCode", "requestBody": { "$ref": "#/$defs/verifyLoginCodeBody" }, "responses": { "200": { "$ref": "#/$defs/authResponse" }, "400": { "$ref": "#/$defs/errorResponseComponent" }, "401": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/auth/refresh": { "post": { "security": [], "operationId": "refreshSession", "requestBody": { "$ref": "#/$defs/refreshSessionBody" }, "responses": { "200": { "$ref": "#/$defs/authResponse" }, "401": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/auth/logout": { "post": { "operationId": "logout", "responses": { "204": { "description": "当前会话已退出" }, "401": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/devices": { "get": { "operationId": "listDevices", "responses": { "200": { "$ref": "#/$defs/deviceListResponse" }, "401": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/devices/{deviceId}": { "delete": { "operationId": "revokeDevice", "parameters": [{ "$ref": "#/$defs/deviceIdParameter" }], "responses": { "204": { "description": "设备已撤销" }, "401": { "$ref": "#/$defs/errorResponseComponent" }, "404": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/files/uploads": { "post": { "operationId": "createFileUpload", "requestBody": { "$ref": "#/$defs/createUploadBody" }, "responses": { "201": { "$ref": "#/$defs/uploadSessionResponse" }, "409": { "$ref": "#/$defs/errorResponseComponent" }, "413": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/files/uploads/{uploadId}/parts/{partNumber}": { "put": { "operationId": "uploadFilePart", "parameters": [{ "$ref": "#/$defs/uploadIdParameter" }, { "$ref": "#/$defs/partNumberParameter" }], "requestBody": { "required": true, "content": { "application/octet-stream": { "schema": { "type": "string", "contentEncoding": "binary" } } } }, "responses": { "200": { "$ref": "#/$defs/uploadPartResponse" }, "404": { "$ref": "#/$defs/errorResponseComponent" }, "409": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/files/uploads/{uploadId}/complete": { "post": { "operationId": "completeFileUpload", "parameters": [{ "$ref": "#/$defs/uploadIdParameter" }], "requestBody": { "$ref": "#/$defs/completeUploadBody" }, "responses": { "200": { "$ref": "#/$defs/fileObjectResponse" }, "409": { "$ref": "#/$defs/errorResponseComponent" }, "422": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/files/{fileObjectId}": { "get": { "operationId": "downloadFileObject", "parameters": [{ "$ref": "#/$defs/fileObjectIdParameter" }], "responses": { "200": { "description": "支持 Range 的原始对象字节", "headers": { "Accept-Ranges": { "schema": { "const": "bytes" } } }, "content": { "application/octet-stream": { "schema": { "type": "string", "contentEncoding": "binary" } } } }, "401": { "$ref": "#/$defs/errorResponseComponent" }, "404": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/sync/push": { "post": { "operationId": "pushMutations", "requestBody": { "$ref": "#/$defs/syncPushBody" }, "responses": { "200": { "$ref": "#/$defs/syncPushResponseComponent" }, "401": { "$ref": "#/$defs/errorResponseComponent" }, "409": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/sync/pull": { "post": { "operationId": "pullEvents", "requestBody": { "$ref": "#/$defs/syncPullBody" }, "responses": { "200": { "$ref": "#/$defs/syncPullResponseComponent" }, "400": { "$ref": "#/$defs/errorResponseComponent" }, "401": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/documents/{documentId}": { "delete": { "operationId": "deleteDocument", "parameters": [{ "$ref": "#/$defs/documentIdParameter" }], "requestBody": { "$ref": "#/$defs/deleteDocumentBody" }, "responses": { "202": { "$ref": "#/$defs/syncEventResponse" }, "409": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/documents/{documentId}/restore": { "post": { "operationId": "restoreDocument", "parameters": [{ "$ref": "#/$defs/documentIdParameter" }], "requestBody": { "$ref": "#/$defs/restoreDocumentBody" }, "responses": { "202": { "$ref": "#/$defs/syncEventResponse" }, "404": { "$ref": "#/$defs/errorResponseComponent" }, "409": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/conflicts": { "get": { "operationId": "listConflicts", "responses": { "200": { "$ref": "#/$defs/conflictListResponse" }, "401": { "$ref": "#/$defs/errorResponseComponent" } } } },
    "/v1/conflicts/{conflictId}/resolve": { "post": { "operationId": "resolveConflict", "parameters": [{ "$ref": "#/$defs/conflictIdParameter" }], "requestBody": { "$ref": "#/$defs/resolveConflictBody" }, "responses": { "200": { "$ref": "#/$defs/conflictResponse" }, "404": { "$ref": "#/$defs/errorResponseComponent" } } } }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque" } } },
  "$defs": {
    "timestamp": { "$ref": "file-contract.schema.json#/$defs/timestamp" },
    "documentId": { "$ref": "file-contract.schema.json#/$defs/documentId" },
    "versionId": { "$ref": "file-contract.schema.json#/$defs/versionId" },
    "fileObjectId": { "$ref": "file-contract.schema.json#/$defs/fileObjectId" },
    "deviceId": { "$ref": "file-contract.schema.json#/$defs/deviceId" },
    "contentHash": { "$ref": "file-contract.schema.json#/$defs/contentHash" },
    "mutationId": { "type": "string", "pattern": "^mut_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "errorCode": { "enum": ["E_AUTH_REQUIRED", "E_AUTH_CODE_INVALID", "E_AUTH_CODE_EXPIRED", "E_ACCOUNT_DELETING", "E_REFRESH_REUSED", "E_DEVICE_REVOKED", "E_PERMISSION_DENIED", "E_FILE_NOT_FOUND", "E_DOCUMENT_NOT_FOUND", "E_OBJECT_MISSING", "E_BASE_VERSION_CONFLICT", "E_CLIENT_MUTATION_REUSED", "E_FILE_TOO_LARGE", "E_HASH_MISMATCH", "E_RATE_LIMITED", "E_STORAGE_UNAVAILABLE", "E_DATABASE_UNAVAILABLE", "E_INTERNAL"] },
    "errorResponse": { "type": "object", "additionalProperties": true, "required": ["ok", "errorCode", "error", "requestId", "retryable"], "properties": { "ok": { "const": false }, "errorCode": { "$ref": "#/$defs/errorCode" }, "error": { "type": "string", "minLength": 1, "maxLength": 1024 }, "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }, "retryable": { "type": "boolean" }, "details": { "type": ["object", "null"], "additionalProperties": true } } },
    "errorResponseComponent": { "description": "稳定错误结构", "content": { "application/json": { "schema": { "$ref": "#/$defs/errorResponse" } } } },
    "okResponse": { "description": "成功", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok"], "properties": { "ok": { "const": true } } } } } },
    "platform": { "enum": ["ios", "android", "windows", "macos", "linux", "web"] },
    "deviceType": { "enum": ["phone", "desktop", "cli", "web"] },
    "deviceRegistration": { "type": "object", "additionalProperties": true, "required": ["installationId", "name", "type", "platform", "appVersion"], "properties": { "installationId": { "type": "string", "minLength": 16, "maxLength": 256 }, "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "type": { "$ref": "#/$defs/deviceType" }, "platform": { "$ref": "#/$defs/platform" }, "appVersion": { "type": "string", "minLength": 1, "maxLength": 64 } } },
    "device": { "type": "object", "additionalProperties": true, "required": ["id", "name", "type", "platform", "appVersion", "trusted", "lastSeenAt", "lastSyncAt", "createdAt", "updatedAt", "revokedAt"], "properties": { "id": { "$ref": "#/$defs/deviceId" }, "name": { "type": "string" }, "type": { "$ref": "#/$defs/deviceType" }, "platform": { "$ref": "#/$defs/platform" }, "appVersion": { "type": "string" }, "trusted": { "type": "boolean" }, "lastSeenAt": { "$ref": "#/$defs/timestamp" }, "lastSyncAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "createdAt": { "$ref": "#/$defs/timestamp" }, "updatedAt": { "$ref": "#/$defs/timestamp" }, "revokedAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] } } },
    "requestLoginCodeRequest": { "type": "object", "additionalProperties": true, "required": ["phoneNumber"], "properties": { "phoneNumber": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$" } } },
    "verifyLoginCodeRequest": { "type": "object", "additionalProperties": true, "required": ["challengeId", "code", "device"], "properties": { "challengeId": { "type": "string" }, "code": { "type": "string", "pattern": "^[0-9]{6}$" }, "device": { "$ref": "#/$defs/deviceRegistration" } } },
    "refreshSessionRequest": { "type": "object", "additionalProperties": true, "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string", "minLength": 32, "maxLength": 1024 } } },
    "authSessionResponse": { "type": "object", "additionalProperties": true, "required": ["ok", "accessToken", "refreshToken", "expiresAt", "device"], "properties": { "ok": { "const": true }, "accessToken": { "type": "string" }, "refreshToken": { "type": "string" }, "expiresAt": { "$ref": "#/$defs/timestamp" }, "device": { "$ref": "#/$defs/device" } } },
    "requestLoginCodeBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/requestLoginCodeRequest" } } } },
    "verifyLoginCodeBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/verifyLoginCodeRequest" } } } },
    "refreshSessionBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/refreshSessionRequest" } } } },
    "authResponse": { "description": "会话", "content": { "application/json": { "schema": { "$ref": "#/$defs/authSessionResponse" } } } },
    "deviceListResponse": { "description": "设备列表", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "devices"], "properties": { "ok": { "const": true }, "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } } } } } } },
    "createUploadRequest": { "type": "object", "additionalProperties": true, "required": ["clientMutationId", "fileObjectId", "role", "format", "contentHash", "sizeBytes", "mediaType"], "properties": { "clientMutationId": { "$ref": "#/$defs/mutationId" }, "fileObjectId": { "$ref": "#/$defs/fileObjectId" }, "role": { "enum": ["original", "derived_artifact", "ai_result"] }, "format": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$" }, "contentHash": { "$ref": "#/$defs/contentHash" }, "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }, "mediaType": { "type": "string" } } },
    "createUploadBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/createUploadRequest" } } } },
    "uploadSessionResponse": { "description": "可恢复上传会话", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "uploadId", "partSize", "uploadedParts", "expiresAt", "alreadyComplete"], "properties": { "ok": { "const": true }, "uploadId": { "type": "string" }, "partSize": { "type": "integer" }, "uploadedParts": { "type": "array", "items": { "type": "integer" } }, "expiresAt": { "$ref": "#/$defs/timestamp" }, "alreadyComplete": { "type": "boolean" } } } } } },
    "uploadPartResponse": { "description": "分片结果", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "partNumber", "etag", "sizeBytes"], "properties": { "ok": { "const": true }, "partNumber": { "type": "integer" }, "etag": { "type": "string" }, "sizeBytes": { "type": "integer" } } } } } },
    "completeUploadRequest": { "type": "object", "additionalProperties": true, "required": ["parts"], "properties": { "parts": { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": true, "required": ["partNumber", "etag"], "properties": { "partNumber": { "type": "integer", "minimum": 1 }, "etag": { "type": "string" } } } } } },
    "completeUploadBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/completeUploadRequest" } } } },
    "fileObjectResponse": { "description": "已校验对象", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "fileObject"], "properties": { "ok": { "const": true }, "fileObject": { "$ref": "file-contract.schema.json#/$defs/fileObject" } } } } } },
    "syncMutation": { "type": "object", "additionalProperties": true, "required": ["clientMutationId", "deviceId", "documentId", "versionId", "baseVersionId", "operation", "retryCount", "payload"], "properties": { "clientMutationId": { "$ref": "#/$defs/mutationId" }, "deviceId": { "$ref": "#/$defs/deviceId" }, "documentId": { "$ref": "#/$defs/documentId" }, "versionId": { "oneOf": [{ "$ref": "#/$defs/versionId" }, { "type": "null" }] }, "baseVersionId": { "oneOf": [{ "$ref": "#/$defs/versionId" }, { "type": "null" }] }, "operation": { "enum": ["upsert", "delete", "archive", "restore"] }, "retryCount": { "type": "integer", "minimum": 0, "maximum": 1000 }, "payload": { "$ref": "lifecycle.schema.json#/$defs/syncPayload" } } },
    "syncPushRequest": { "type": "object", "additionalProperties": true, "required": ["deviceId", "mutations"], "properties": { "deviceId": { "$ref": "#/$defs/deviceId" }, "mutations": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/syncMutation" } } } },
    "syncPushBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/syncPushRequest" } } } },
    "syncPushResponseComponent": { "description": "逐项提交结果", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "results"], "properties": { "ok": { "type": "boolean" }, "results": { "type": "array", "items": { "type": "object", "additionalProperties": true, "required": ["clientMutationId", "ok", "event", "error"], "properties": { "clientMutationId": { "$ref": "#/$defs/mutationId" }, "ok": { "type": "boolean" }, "event": { "oneOf": [{ "$ref": "lifecycle.schema.json#/$defs/syncEvent" }, { "type": "null" }] }, "error": { "oneOf": [{ "$ref": "#/$defs/errorResponse" }, { "type": "null" }] } } } } } } } } },
    "syncPullRequest": { "type": "object", "additionalProperties": true, "required": ["deviceId", "cursor", "limit"], "properties": { "deviceId": { "$ref": "#/$defs/deviceId" }, "cursor": { "type": ["string", "null"], "maxLength": 512 }, "limit": { "type": "integer", "minimum": 1, "maximum": 500 } } },
    "syncPullBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/syncPullRequest" } } } },
    "syncPullResponse": { "type": "object", "additionalProperties": true, "required": ["ok", "cursor", "events", "hasMore"], "properties": { "ok": { "const": true }, "cursor": { "type": "string", "minLength": 1 }, "events": { "type": "array", "items": { "$ref": "lifecycle.schema.json#/$defs/syncEvent" } }, "hasMore": { "type": "boolean" } } },
    "syncPullResponseComponent": { "description": "有序增量事件", "content": { "application/json": { "schema": { "$ref": "#/$defs/syncPullResponse" } } } },
    "deleteDocumentRequest": { "type": "object", "additionalProperties": true, "required": ["clientMutationId", "deviceId", "baseVersionId", "scope"], "properties": { "clientMutationId": { "$ref": "#/$defs/mutationId" }, "deviceId": { "$ref": "#/$defs/deviceId" }, "baseVersionId": { "oneOf": [{ "$ref": "#/$defs/versionId" }, { "type": "null" }] }, "scope": { "enum": ["current_device", "cloud", "all_devices"] } } },
    "restoreDocumentRequest": { "type": "object", "additionalProperties": true, "required": ["clientMutationId", "deviceId"], "properties": { "clientMutationId": { "$ref": "#/$defs/mutationId" }, "deviceId": { "$ref": "#/$defs/deviceId" } } },
    "deleteDocumentBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/deleteDocumentRequest" } } } },
    "restoreDocumentBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/restoreDocumentRequest" } } } },
    "syncEventResponse": { "description": "同步事件", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "event"], "properties": { "ok": { "const": true }, "event": { "$ref": "lifecycle.schema.json#/$defs/syncEvent" } } } } } },
    "conflict": { "type": "object", "additionalProperties": true, "required": ["id", "documentId", "localVersionId", "remoteVersionId", "detectedAt", "resolvedAt", "resolution"], "properties": { "id": { "type": "string", "pattern": "^con_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "documentId": { "$ref": "#/$defs/documentId" }, "localVersionId": { "$ref": "#/$defs/versionId" }, "remoteVersionId": { "$ref": "#/$defs/versionId" }, "detectedAt": { "$ref": "#/$defs/timestamp" }, "resolvedAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "resolution": { "oneOf": [{ "enum": ["keep_local", "keep_remote", "save_copy", "manual_merge"] }, { "type": "null" }] } } },
    "resolveConflictRequest": { "type": "object", "additionalProperties": true, "required": ["clientMutationId", "resolution"], "properties": { "clientMutationId": { "$ref": "#/$defs/mutationId" }, "resolution": { "enum": ["keep_local", "keep_remote", "save_copy", "manual_merge"] } } },
    "resolveConflictBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/$defs/resolveConflictRequest" } } } },
    "conflictListResponse": { "description": "未解决冲突", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "conflicts"], "properties": { "ok": { "const": true }, "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } } } } } } },
    "conflictResponse": { "description": "冲突结果", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true, "required": ["ok", "conflict"], "properties": { "ok": { "const": true }, "conflict": { "$ref": "#/$defs/conflict" } } } } } },
    "deviceIdParameter": { "name": "deviceId", "in": "path", "required": true, "schema": { "$ref": "#/$defs/deviceId" } },
    "documentIdParameter": { "name": "documentId", "in": "path", "required": true, "schema": { "$ref": "#/$defs/documentId" } },
    "fileObjectIdParameter": { "name": "fileObjectId", "in": "path", "required": true, "schema": { "$ref": "#/$defs/fileObjectId" } },
    "uploadIdParameter": { "name": "uploadId", "in": "path", "required": true, "schema": { "type": "string" } },
    "partNumberParameter": { "name": "partNumber", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1, "maximum": 10000 } },
    "conflictIdParameter": { "name": "conflictId", "in": "path", "required": true, "schema": { "type": "string" } }
  }
}
