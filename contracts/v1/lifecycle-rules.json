{
  "schemaVersion": "1.0.0",
  "initialState": "temporary_open",
  "states": [
    "temporary_open",
    "read",
    "collected",
    "sync_pending",
    "synced",
    "conversion_pending",
    "ai_readable",
    "ai_read",
    "ai_result_ready",
    "archived",
    "failed",
    "cancelled",
    "conflict",
    "deleted"
  ],
  "transitions": {
    "temporary_open": ["read", "collected", "failed", "cancelled", "deleted"],
    "read": ["collected", "failed", "cancelled", "deleted"],
    "collected": ["sync_pending", "conversion_pending", "archived", "failed", "cancelled", "conflict", "deleted"],
    "sync_pending": ["synced", "archived", "failed", "cancelled", "conflict", "deleted"],
    "synced": ["sync_pending", "conversion_pending", "archived", "failed", "cancelled", "conflict", "deleted"],
    "conversion_pending": ["ai_readable", "archived", "failed", "cancelled", "conflict", "deleted"],
    "ai_readable": ["ai_read", "conversion_pending", "archived", "failed", "cancelled", "conflict", "deleted"],
    "ai_read": ["ai_result_ready", "conversion_pending", "archived", "failed", "cancelled", "conflict", "deleted"],
    "ai_result_ready": ["conversion_pending", "archived", "failed", "cancelled", "conflict", "deleted"],
    "archived": ["collected", "sync_pending", "synced", "failed", "conflict", "deleted"],
    "failed": [],
    "cancelled": [],
    "conflict": ["collected", "sync_pending", "synced", "deleted"],
    "deleted": ["conflict"]
  },
  "errors": {
    "E_PERMISSION_DENIED": { "retryable": true, "userMessageKey": "error.permission_denied", "recoveryAction": "reselect_file" },
    "E_SOURCE_MISSING": { "retryable": true, "userMessageKey": "error.source_missing", "recoveryAction": "reselect_file" },
    "E_UNSUPPORTED_FORMAT": { "retryable": false, "userMessageKey": "error.unsupported_format", "recoveryAction": "open_on_computer" },
    "E_BINARY_CONTENT": { "retryable": false, "userMessageKey": "error.binary_content", "recoveryAction": "open_on_computer" },
    "E_FILE_TOO_LARGE": { "retryable": false, "userMessageKey": "error.file_too_large", "recoveryAction": "open_on_computer" },
    "E_DECODE_FAILED": { "retryable": true, "userMessageKey": "error.decode_failed", "recoveryAction": "choose_encoding" },
    "E_STORAGE_FULL": { "retryable": true, "userMessageKey": "error.storage_full", "recoveryAction": "free_space" },
    "E_SYNC_NETWORK": { "retryable": true, "userMessageKey": "error.sync_network", "recoveryAction": "retry" },
    "E_SYNC_METADATA_COMMIT": { "retryable": true, "userMessageKey": "error.sync_metadata_commit", "recoveryAction": "retry_metadata" },
    "E_DEVICE_REVOKED": { "retryable": false, "userMessageKey": "error.device_revoked", "recoveryAction": "sign_in_again" },
    "E_BASE_VERSION_CONFLICT": { "retryable": false, "userMessageKey": "error.base_version_conflict", "recoveryAction": "resolve_conflict" },
    "E_OBJECT_MISSING": { "retryable": true, "userMessageKey": "error.object_missing", "recoveryAction": "retry_download" },
    "E_DOCUMENT_DELETED": { "retryable": false, "userMessageKey": "error.document_deleted", "recoveryAction": "none" },
    "E_CANCELLED": { "retryable": true, "userMessageKey": "error.cancelled", "recoveryAction": "resume" },
    "E_CLIENT_MUTATION_REUSED": { "retryable": false, "userMessageKey": "error.client_mutation_reused", "recoveryAction": "report_error" },
    "E_UNKNOWN": { "retryable": true, "userMessageKey": "error.unknown", "recoveryAction": "retry" }
  }
}
